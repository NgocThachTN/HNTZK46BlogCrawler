{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/blog/:id",
      "destination": "/index.html"
    },
    {
      "source": "/member/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|images/|member/.*\\.json|blogs\\.json|favicon\\.svg|icons\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
