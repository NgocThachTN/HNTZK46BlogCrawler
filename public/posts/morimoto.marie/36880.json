  "contentHtml": "\n                      <p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">こんばんは。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">東京都出身、高校</span><span class=\"s2\">2</span><span class=\"s1\">年生</span><span class=\"s2\">16</span><span class=\"s1\">歳の</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">森本</span><span class=\"s2\">&nbsp;</span><span class=\"s1\">茉莉</span><span class=\"s2\">(</span><span class=\"s1\">もりもと</span><span class=\"s2\">&nbsp;</span><span class=\"s1\">まりぃ</span><span class=\"s2\">)</span><span class=\"s1\">です。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><br></p><p class=\"p3\" style=\"margin:9px 0px 8px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"></p><div><img src=\"/images/blogs/morimoto.marie/2020-12-10/36880_0.jpg\" style=\"max-width: 100%;\"></div><p></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">山口陽世が描いてくれました。</span><span class=\"s2\">&nbsp;</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">私のサイリウムカラーのオレンジ</span><span class=\"s2\">×</span><span class=\"s1\">青も使ってくれてる</span><span class=\"s2\">( ; _ ; )♡</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">凄く嬉しくて何かのアイコンにしたいなと思ったのですが、少し恥ずかしいので、、。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">でも、この嬉しい気持ちを共有したいなと思いブログに載せたのです！</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">陽世はよく人物画を描いていてその絵が私は好きですしどれも凄く上手なので</span><span class=\"s2\">(</span><span class=\"s1\">私の似顔絵は実物の</span><span class=\"s2\">40</span><span class=\"s1\">割増位にはかわいいいです</span><span class=\"s2\">)</span><span class=\"s1\">、</span></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">自身のブログに載せることを勧めたのですが、｢恥ずかしいけん｣と言っておりましたので私が載せちゃいました。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">いつも鉛筆などで描いているイメージだったのですが、最近はタブレットで描くのにもハマっているみたいです</span><span class=\"s3\">🙄✊🏻</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">陽世ありがとう</span><span class=\"s2\">(</span><span class=\"s4\">ˊ</span><span class=\"s5\" style=\"font-family:&quot;Euphemia UCAS&quot;\">ᗜ</span><span class=\"s4\">ˋ</span><span class=\"s2\">)</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">┈┈┈┈┈┈┈</span><span class=\"s2\">&nbsp;</span><span class=\"s6\">❁</span><span class=\"s2\">&nbsp;</span><span class=\"s6\">❁</span><span class=\"s2\">&nbsp;</span><span class=\"s6\">❁</span><span class=\"s2\">&nbsp;</span><span class=\"s1\">┈┈┈┈┈┈┈┈</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s2\">9</span><span class=\"s1\">日に発売された｢</span><span class=\"s2\">blt graph.</span><span class=\"s1\">｣さん、お手にとっていただけましたでしょうか</span><span class=\"s3\">😌💭</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">オフショットをいただいたので、載せますね。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p3\" style=\"margin:9px 0px 8px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"></p><div><div><img src=\"/images/blogs/morimoto.marie/2020-12-10/36880_1.jpg\" style=\"max-width: 100%;\"></div></div><p></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">天候に恵まれました！</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">外でぶらぶらしている時は勿論なのですが、暖かい陽が差し込むお部屋にいる時もずっとポカポカしていて凄く気持ちが良かったです〜</span><span class=\"s7\" style=\"font-family:Menlo-Regular\">☼</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"></p><div dir=\"auto\"><span class=\"s1\" style=\"border-color:rgb(255,255,255)\"><div dir=\"auto\"><span class=\"s1\" style=\"border-color:rgb(255,255,255)\"><div><img src=\"/images/blogs/morimoto.marie/2020-12-10/36880_2.jpg\" style=\"max-width: 100%;\"></div>沢山の方がこのワンピース似合ってると言ってくださって、嬉しいです！赤を選ぶことは少ないのですが、このお洋服は一目惚れしました</span><span class=\"s3\" style=\"border-color:rgb(255,255,255)\">😚💖</span></div></span></div><p></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">靴下の色、靴までかわいいです、、。そうそう、以前ドラマを観ていた時｢いい靴を履くと、その靴がいいところへ連れて行ってくれる｣という台詞に惹かれたんですよね。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">急に思い出しました。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">自分がいいと思うところが具体的に分からず自らその場所に向かうことができない私は、今はいい靴に頼ってみようかなと思います。</span><span class=\"s2\">(</span><span class=\"s1\">他力本願</span><span class=\"s2\">)</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\" dir=\"auto\"><span class=\"s1\">靴にまつわるこんなエピソードあるよという方いましたら、教えていただきたいです！</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">話が逸れたので、戻します</span><span class=\"s2\">(&nbsp;</span><span class=\"s4\">ˊᵕˋ</span><span class=\"s2\">&nbsp;;)</span><span class=\"s3\">💦</span></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"></p><div><img src=\"/images/blogs/morimoto.marie/2020-12-10/36880_3.jpg\" style=\"max-width: 100%;\"></div><p></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">真っ白なお部屋での撮影でした。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\" dir=\"auto\"><span class=\"s1\">この撮影で森本は布団のシーツをマントみたいに羽織ったとき、どういう風に空気を入れたらシーツが綺麗にふわっとなるのかを学びました</span><span class=\"s3\">🥸👍🏻</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\" dir=\"auto\"><span class=\"s1\">メッセージにもオフショットいくつかお送りしますね！</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">今日はこの辺りで失礼させていただきます。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">ブログ読んでくださり、有難うございました。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">では、またお会いしましょう。</span></p>\n                    ",
  "contentHtmlFurigana": "\n                      <p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\">こんばんは。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\"><ruby>東京<rt>とうきょう</rt></ruby><ruby>都<rt>と</rt></ruby><ruby>出身<rt>しゅっしん</rt></ruby>、<ruby>高校<rt>こうこう</rt></ruby></span><span class=\"s2\">2</span><span class=\"s1\"><ruby>年<rt>とし</rt></ruby><ruby>生<rt>せい</rt></ruby></span><span class=\"s2\">16</span><span class=\"s1\"><ruby>歳<rt>とし</rt></ruby>の</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p1\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"><span class=\"s1\"><ruby>森本<rt>もりもと</rt></ruby></span><span class=\"s2\">&nbsp;</span><span class=\"s1\"><ruby>茉莉<rt>まり</rt></ruby></span><span class=\"s2\">(</span><span class=\"s1\">もりもと</span><span class=\"s2\">&nbsp;</span><span class=\"s1\">まりぃ</span><span class=\"s2\">)</span><span class=\"s1\">です。</span></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><span class=\"s2\"></span><br></p><p class=\"p2\" style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;min-height:20.3px;color:rgb(0,0,0)\"><br></p><p class=\"p3\" style=\"margin:9px 0px 8px;font-stretch:normal;font-size:17px;line-height:normal;color:rgb(0,0,0)\"></p><div><img src=\"/images/blogs/morimoto.marie/2020-12-10/